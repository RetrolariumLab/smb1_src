  "excluded_scope": [
    {
      "id": "vs_point_playtest",
      "status": "unsupported",
      "reason": "Vs. Super Mario Bros. plays in Retrolarium from power-on; starting from a chosen point is not supported yet."
    },
    {
      "id": "expanded_cnrom_editing",
      "status": "planned",
      "reason": "The expanded CNROM variant repeats the original's PRG and CHR; its revision in the kit comes with its first content variant."
    }
  ],
  "delta": [
    {
      "id": "retrolarium-descriptor",
      "kind": "tooling",
      "summary": "super_mario_bros.rlj names the game, its profile smb1.v1, the seven revisions it builds and its asset split; the studio's views come from the kit."
    },
    {
      "id": "editing-moves-to-retrolarium",
      "kind": "tooling",
      "summary": "The four Tkinter studios, their models, the content workspace and composer, the embedded FCEUX playtest, their tests, Make targets and documentation are removed; the last comparison of the kit's resources with the studios matched in all seven revisions, and editing happens in Retrolarium Studio over hack/<revision>/ (docs/retrolarium.md)."
    },
    {
      "id": "gate-codecs-to-owners",
      "kind": "tooling",
      "summary": "The data-format codecs the round-trip gate proves move to scripts/build/data_formats.py with config/data_formats.json, and the relocation gate reads the music bank through the read-only scripts/validation/music_decoder.py."
    },
    {
      "id": "studio-check",
      "kind": "validation",
      "summary": "make studio-check: in a throwaway copy the kit prepares, validates and rebuilds every revision with no edits, byte for byte."
    },
    {
      "id": "tag-bound-2x-audits",
      "kind": "validation",
      "summary": "The 2.0, 2.1 and 2.2 manifests describe their tags, so their audits run in a disposable clone of each tag with the tag's own Make targets (validation.tag_audit); the functional 2.x gates stay on HEAD without the studios."
    },
    {
      "id": "object-names",
      "kind": "source",
      "summary": "Constants name the firebars, the lifts, the enemy groups and enemy $09, the grey Cheep-Cheep and the area-style objects; every revision still builds byte for byte."
    },
    {
      "id": "kit-toolchain",
      "kind": "toolchain",
      "summary": "The repository no longer carries ca65 and ld65: the build asks Retrolarium Kit for the cc65 2.19 0fca835 it builds and ships, and the 2.1 and 2.2 toolchain checks read the released binaries from their tags."
    },
    {
      "id": "shared-linter",
      "kind": "tooling",
      "summary": "make lint and make format run Retrolarium Kit's shared linter over config/lint.json; asm_style.py and its tests move to the kit, and the game's source invariants stay here."
    },
    {
      "id": "game-names",
      "kind": "tooling",
      "summary": "config/names.json keeps the game's own names, in English, and the lists that carry them; Retrolarium reads them when a project opens and keeps none itself."
    },
    {
      "id": "game-profile",
      "kind": "tooling",
      "summary": "config/game_profile.json is the game's Retrolarium profile: its revisions with their hashes and where each resource lies in each image. Retrolarium Kit reads it when it opens the repository and keeps no copy."
    },
    {
      "id": "profile-tables",
      "kind": "tooling",
      "summary": "config/profile_tables.json names by label the tables Retrolarium Kit reads from the image built from this source."
    }
  ],
